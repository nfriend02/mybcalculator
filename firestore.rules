rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio demo app (mybcalculator) — public read/write with status field.
    function hasStatus() {
      return request.resource.data.keys().hasAll(['status'])
        && request.resource.data.status is string;
    }

    match /calculations/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }
    match /schedules/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }
    match /expenses/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }
    match /uploads/{docId} {
      allow read: if true;
      allow create, update: if hasStatus();
      allow delete: if true;
    }
  }
}
