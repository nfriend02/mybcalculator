# Copy to `.env` and fill secrets. Netlify: same keys in Environment variables.
# Project id: hswarehouse
# Do NOT commit real API keys — set them in Netlify Env / local `.env` only.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=hswarehouse.firebaseapp.com
FIREBASE_PROJECT_ID=hswarehouse
FIREBASE_STORAGE_BUCKET=hswarehouse.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=584793321765
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=G-KHG6Q96FSG

# Optional external APIs (used via /api prefix in shared layer)
OPENWEATHER_API_KEY=your_openweather_key
EXCHANGE_RATE_API_KEY=your_exchangerate_key
# Prefer unquoted value. Quotes are stripped at runtime if present.
GEMINI_API_KEY=
# Optional override (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

